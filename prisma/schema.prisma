generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum DocumentType {
  POLICY
  DOCUMENT
  LINK
}

enum SponsorType {
  CLUB
  TEAM
}

enum FixtureType {
  MATCH
  TRAINING
}

enum FixtureStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
  COMPLETED
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  PENALTY_MISSED
  VAR_DECISION
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  MPESA
  MOCK
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  role            UserRole          @default(CUSTOMER)
  sessions        Session[]
  orders          Order[]
  addresses       CustomerAddress[]
  cart            Cart?
  newsArticles    NewsArticle[]     @relation("ArticleAuthor")
  passwordResetTokens PasswordResetToken[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  shortName     String?
  logoUrl       String?
  coverPhotoUrl String?
  blurb         String?
  isClub        Boolean        @default(true)
  isActive      Boolean        @default(true)
  players       Player[]
  officials     TeamOfficial[]
  homeMatches   Fixture[]      @relation("HomeTeam")
  awayMatches   Fixture[]      @relation("AwayTeam")
  tableRows     LeagueTable[]
  competitions  Competition[]  @relation("CompetitionTeams")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TeamOfficial {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  role      String
  photoUrl  String?
  phone     String?
  email     String?
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([teamId])
}

model Player {
  id              String                  @id @default(cuid())
  teamId          String?
  firstName       String
  lastName        String
  slug            String                  @unique
  position        PlayerPosition
  squadNumber     Int?
  photoUrl        String?
  bio             String?
  dateOfBirth     DateTime?
  nationality     String?
  isActive        Boolean                 @default(true)
  team            Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  statistics      PlayerSeasonStatistic[]
  matchEvents     MatchEvent[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  @@index([teamId, position])
}

model PlayerSeasonStatistic {
  id              String   @id @default(cuid())
  playerId        String
  season          String
  appearances     Int      @default(0)
  starts          Int      @default(0)
  subOn           Int      @default(0)
  subOff          Int      @default(0)
  minutes         Int      @default(0)
  goals           Int      @default(0)
  assists         Int      @default(0)
  penalties       Int      @default(0)
  penaltiesMissed Int      @default(0)
  ownGoals        Int      @default(0)
  yellowCards     Int      @default(0)
  redCards        Int      @default(0)
  cleanSheets     Int      @default(0)
  isDemoData      Boolean  @default(true)
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([playerId, season])
  @@index([season])
}

model Competition {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  season      String?
  country     String?
  isOfficial  Boolean      @default(false)
  description String?
  about       String?
  branches    Json?
  fixtures    Fixture[]
  tableRows   LeagueTable[]
  teams          Team[]         @relation("CompetitionTeams")
  isLeague       Boolean        @default(true)
  showOnHomepage Boolean        @default(false)
  showOnTeamPage Boolean        @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Fixture {
  id             String          @id @default(cuid())
  competitionId  String?
  homeTeamId     String
  awayTeamId     String
  kickoffAt      DateTime
  venue          String?
  type           FixtureType     @default(MATCH)
  status         FixtureStatus   @default(SCHEDULED)
  homeScore      Int?
  awayScore      Int?
  attendance     Int?
  matchReport    String?
  isDemoData     Boolean         @default(true)
  competition    Competition?    @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  homeTeam       Team             @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam       Team             @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  events         MatchEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@index([kickoffAt])
  @@index([homeTeamId, awayTeamId])
  @@index([type])
}

model MatchEvent {
  id         String          @id @default(cuid())
  fixtureId  String
  playerId   String?
  type       MatchEventType
  minute     Int?
  detail     String?
  fixture    Fixture         @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  player     Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  @@index([fixtureId, minute])
}

model LeagueTable {
  id            String      @id @default(cuid())
  competitionId String
  teamId        String
  position      Int
  played        Int         @default(0)
  wins          Int         @default(0)
  draws         Int         @default(0)
  losses        Int         @default(0)
  goalsFor      Int         @default(0)
  goalsAgainst  Int         @default(0)
  points        Int         @default(0)
  isDemoData    Boolean     @default(true)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([competitionId, teamId])
  @@index([competitionId, position])
}

model NewsCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  about       String?
  branches    Json?
  articles    NewsArticle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model NewsArticle {
  id            String          @id @default(cuid())
  categoryId    String?
  authorId      String?
  title         String
  slug          String          @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  status        NewsStatus      @default(DRAFT)
  publishedAt   DateTime?
  seoTitle      String?
  seodescription String?
  about       String?
  branches    Json?
  canonicalUrl  String?
  isDemoData    Boolean         @default(false)
  category      NewsCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author        User?           @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@index([status, publishedAt])
  @@index([categoryId])
}

model Gallery {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  about       String?
  branches    Json?
  published   Boolean        @default(false)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GalleryImage {
  id         String   @id @default(cuid())
  galleryId  String
  url        String
  altText    String
  caption    String?
  sortOrder  Int      @default(0)
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@index([galleryId, sortOrder])
}

model Video {
  id          String   @id @default(cuid())
  title       String
  url         String
  thumbnailUrl String?
  description String?
  about       String?
  branches    Json?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  about       String?
  branches    Json?
  category    String
  status      ProductStatus   @default(DRAFT)
  featured    Boolean         @default(false)
  images      ProductImage[]
  variants    ProductVariant[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([status, featured])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  sku        String      @unique
  size       String?
  price      Decimal     @db.Decimal(12, 2)
  salePrice  Decimal?    @db.Decimal(12, 2)
  stock      Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  @@index([productId, size])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  altText    String
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@index([productId, sortOrder])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@unique([cartId, variantId])
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  userId           String?
  status           OrderStatus   @default(PENDING_PAYMENT)
  currency         String        @default("KES")
  subtotal         Decimal       @db.Decimal(12, 2)
  shippingFee      Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  customerName     String
  customerEmail    String
  customerPhone    String
  deliveryAddress  String
  deliveryCity     String
  deliveryCounty   String?
  notes            String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  variantId     String?
  productName   String
  sku           String
  size          String?
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  lineTotal     Decimal        @db.Decimal(12, 2)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model Payment {
  id                 String          @id @default(cuid())
  orderId            String
  provider           PaymentProvider
  status             PaymentStatus   @default(PENDING)
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("KES")
  phoneNumber        String?
  transactionReference String?       @unique
  checkoutRequestId  String?         @unique
  merchantRequestId  String?
  providerReceipt    String?
  providerResponse   Json?
  failureReason      String?
  processedAt        DateTime?
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  @@index([orderId, status])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  userId        String
  label         String
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  county        String?
  postalCode    String?
  isDefault     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId, isDefault])
}

model Sponsor {
  id          String       @id @default(cuid())
  name        String
  logoUrl     String?
  websiteUrl  String?
  description String?
  about       String?
  branches    Json?
  type        SponsorType  @default(CLUB)
  displayOrder Int         @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([type, active])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id          String               @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  status      ContactMessageStatus @default(NEW)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@index([status, createdAt])
}

model Document {
  id        String       @id @default(cuid())
  title     String
  url       String
  type      DocumentType @default(DOCUMENT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  @@index([type])
}

